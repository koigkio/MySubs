<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MySubs.AddBalanceWindow"
        Title="Пополнить баланс💵"
        Width="350" Height="280"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20" Spacing="15">
        <TextBlock Text="Пополнение баланса" FontSize="20" FontWeight="Bold" Foreground="#FF87CEFA"/>
        <StackPanel Spacing="5">
            <TextBlock Text="Сумма пополнения:"/>
            <TextBox Name="AmountInput" PlaceholderText="0.00"/>
        </StackPanel>
        <StackPanel Spacing="5">
            <TextBlock Text="Способ оплаты:"/>
            <ComboBox Name="PaymentMethodInput" SelectedIndex="0">
                <ComboBoxItem>💳 Банковская карта</ComboBoxItem>
                <ComboBoxItem>₿ Криптовалюта</ComboBoxItem>
                <ComboBoxItem>💵 Наличные</ComboBoxItem>
            </ComboBox>
        </StackPanel>
        <StackPanel Spacing="5">
            <TextBlock Text="Описание (необязательно):"/>
            <TextBox Name="DescriptionInput" PlaceholderText="Например: пополнение за март"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
            <Button Name="CancelButton" Content="Отмена" Background="Gray" Foreground="White" Width="80"/>
            <Button Name="SaveButton" Content="Пополнить" Background="Blue" Foreground="White" Width="80"/>
        </StackPanel>
    </StackPanel>
</Window>