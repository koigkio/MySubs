<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450"
        x:Class="MySubs.MainWindow"
        Title="MySubs">
  <Grid ColumnDefinitions="200,*">   
        
        <!-- ЛЕВАЯ ПАНЕЛЬ -->
        <StackPanel Grid.Column="0" Margin="20">
            <TextBlock Text="MySubs"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="#FF87CEFA"
                       Margin="0,0,0,20" />
 
            <Button Content="+ Добавить подписку" 
                    Width="170"
                    Foreground="White"
                    Background="Blue"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,0,10"
                    Click="AddButton_Click"/> 

         <Button Content="Пополнить баланс💸" 
                    Width="170"
                    Foreground="Black"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,0,10"
                    Click="AddButton1_Click"/> 

        </StackPanel>
        
        <!-- ПРАВАЯ ПАНЕЛЬ -->
        <StackPanel Grid.Column="1" Margin="20">
            
            <!-- Шапка: Заголовок слева, Баланс справа -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                <TextBlock Grid.Column="0"
                           Text="Управление Подписками"
                           FontSize="24"
                           FontWeight="Bold" />  

                <Border Grid.Column="1"
                        Background="#FFF0F8FF"
                        Padding="10,5"
                        CornerRadius="5">
                    <TextBlock Text="Баланс: 0 ₽" 
                               Foreground="Black"
                               FontWeight="Medium" />
                </Border>
            </Grid>
            
            <!-- Поиск (Watermark заменен на корректный PlaceholderText) -->
            <TextBox PlaceholderText="🔎 Искать подписку..."
                     Margin="0,0,0,20" />
            
        </StackPanel>
    </Grid>
</Window>
