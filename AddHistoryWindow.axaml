<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MySubs.AddHistoryWindow"
        Title="Все пополнения баланса💵"
        Width="500" Height="450"
        CanResize="True"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20" Spacing="15">
        <TextBlock Text="Все пополнения баланса💵" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Foreground="#FF87CEFA"
                   HorizontalAlignment="Center"/>

        <!-- Добавляем блок с общей суммой -->
        <Border Background="#FFEBEE" Padding="10,5" >
            <TextBlock Name="TxtTotalHistory" 
                       Text="💰 Всего пополнено: 0 ₽" 
                       FontSize="14" 
                       FontWeight="Bold" 
                       Foreground="#E74C3C" 
                       HorizontalAlignment="Center"/>
        </Border>
        
        <!-- Список расходов  -->
        <ListBox Name="ListHistory" 
                 Height="300"
                 Background="White"
                 BorderThickness="1"
                 BorderBrush="#E0E0E0"/>
        
        <!-- Кнопки -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Name="CloseButton" Content="Закрыть" Background="Gray" Foreground="White"/>
        </StackPanel>
    </StackPanel>
</Window>