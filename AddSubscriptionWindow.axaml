<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MySubs.AddSubscriptionWindow"
        Title="Добавить подписку💼"
        Width="400" Height="480"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    
    <ScrollViewer>
        <StackPanel Margin="15">
            
            <TextBlock Text="Добавление подписки"
                       FontSize="20" 
                       FontWeight="Bold" 
                       Foreground="#FF87CEFA"
                       Margin="0,0,0,15"/>
            
            <TextBlock Text="Название:" Margin="0,5,0,3"/>
            <TextBox Name="TitleInput" PlaceholderText="Netflix, Spotify"/>
            
            <TextBlock Text="Цена:" Margin="0,10,0,3"/>
            <TextBox Name="PriceInput" PlaceholderText="0.00"/>
            
            <TextBlock Text="Способ оплаты:" Margin="0,10,0,3"/>
            <ComboBox Name="PayMethodInput" SelectedIndex="0">
                <ComboBoxItem Tag="card">💳 Банковская карта</ComboBoxItem>
                <ComboBoxItem Tag="crypto">₿ Криптовалюта</ComboBoxItem>
                <ComboBoxItem Tag="foreign_card">🌍 Иностранная карта</ComboBoxItem>
            </ComboBox>
            
            <TextBlock Text="Валюта:" Margin="0,10,0,3"/>
            <ComboBox Name="CurrencyInput" SelectedIndex="0">
                <ComboBoxItem>₽ (Рубль)</ComboBoxItem>
                <ComboBoxItem>$ (Доллар)</ComboBoxItem>
                <ComboBoxItem>€ (Евро)</ComboBoxItem>
            </ComboBox>
            
            <TextBlock Text="Описание:" Margin="0,10,0,3"/>
            <TextBox Name="DescriptionInput" TextWrapping="Wrap" Height="60" PlaceholderText="Необязательно"/>
            
            <CheckBox Name="AutoRenewCheck" Content="🔄 Автоматическое продление" IsChecked="True" Margin="0,10,0,0"/>
            
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Right" 
                        Spacing="10" 
                        Margin="0,20,0,0">
                <Button Name="CancelButton" Content="Отмена" Background="Gray" Foreground="White" Width="80"/>
                <Button Name="SaveButton" Content="Сохранить" Background="Blue" Foreground="White" Width="80"/>
            </StackPanel>
            
        </StackPanel>
    </ScrollViewer>
</Window>