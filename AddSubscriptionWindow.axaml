<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MySubs.AddSubscriptionWindow"
        Title="Добавить новую подписку"
        Width="350" Height="320"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20" Spacing="15">
        <TextBlock Text="Новая подписка" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Foreground="#FF87CEFA"/>

        <StackPanel Spacing="5">
            <TextBlock Text="Название подписки:"/>
            <TextBox Name="NameInput" Watermark="Например, Яндекс Плюс"/>
        </StackPanel>

    
        <StackPanel Spacing="5">
            <TextBlock Text="Стоимость (руб):"/>
            <TextBox Name="PriceInput" Watermark="0.00"/>
        </StackPanel>

        <StackPanel Spacing="5">
            <TextBlock Text="Срок действия:"/>
            <TextBox Name="TermInput" Watermark="30 дней или 1 месяц"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
            <Button Name="CancelButton" Content="Отмена" Background="Gray" Foreground="White"/>
            <Button Name="SaveButton" Content="Сохранить" Background="Blue" Foreground="White"/>
        </StackPanel>
    </StackPanel>
</Window>